{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "local-app/client/**/*.ts",
    "local-app/client/**/*.tsx",
    "local-app/server/**/*.ts",
    "local-app/vite.client.config.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "local-app/dist"]
}
